# Copie para .env. Nunca envie o .env para o GitHub.
ADMIN_EMAIL=admin@example.com
# Mínimo 12 caracteres. Cria a conta somente no primeiro início.
ADMIN_PASSWORD=
# Use apenas letras e números nesta senha para compor a URL do banco.
DB_PASSWORD=
APP_ORIGIN=http://localhost:8080
APP_PORT=8080
BIND_ADDRESS=127.0.0.1
# Em produção HTTPS, obrigatório true.
COOKIE_SECURE=false
# Opcionais: recuperação de senha por e-mail (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
